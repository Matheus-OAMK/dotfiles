{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "blue",
      "2": "blue",
    },
    "padding": {
      "right": 3,
      "top": 1,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────System──────────────────┐",
    },
    {
      "type": "os",
      "key": "󰣇 OS",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Packages",
      "keyColor": "blue",
      "format": "{pacman} (pacman), {flatpak-all} (flatpak)",
    },
    {
      "type": "wm",
      "key": "│ ├ WM",
      "keyColor": "blue",
    },
    {
      "type": "cpu",
      "key": "│ ├ CPU",
      "keyColor": "blue",
    },
    {
      "type": "memory",
      "key": "│ ├ Memory",
      "keyColor": "blue",
    },
    {
      "type": "uptime",
      "key": "└ └󰅐 Uptime",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────┘",
    },
  ],
}
